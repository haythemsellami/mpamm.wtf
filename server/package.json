{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --ignore \"**/data/**\" --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify-adapter": "tsx --env-file-if-exists=../.env scripts/verify-adapter.ts"
  },
  "dependencies": {
    "@mpamm/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "viem": "^2.21.55",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "license": "AGPL-3.0-only"
}
