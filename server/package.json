{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch --ignore \"**/data/**\" --env-file-if-exists=../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../.env src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify-adapter": "tsx --env-file-if-exists=../.env scripts/verify-adapter.ts",
    "benchmark:delivery": "tsx scripts/benchmark-delivery.ts",
    "benchmark:runtime": "tsx scripts/benchmark-runtime.ts",
    "benchmark:markouts": "tsx scripts/benchmark-markouts.ts",
    "benchmark:heads": "tsx scripts/benchmark-heads.ts",
    "benchmark:live": "tsx scripts/benchmark-live-stream.ts"
  },
  "dependencies": {
    "@mpamm/shared": "*",
    "compression": "1.8.2",
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "viem": "^2.57.4",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  },
  "license": "AGPL-3.0-only"
}
