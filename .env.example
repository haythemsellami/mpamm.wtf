# Copy to .env — every variable is optional (defaults in server/src/config.ts).

# A trusted Monad RPC. The public default works, but is rate-limited and caps
# getLogs ranges (slow venue-lifetime backfills).
#RPC_HTTP_URL=
#RPC_WS_URL=

# High-resolution depth runs in a child process. Give it a separate RPC so its
# 25-point curve cannot consume the realtime quote node's request quota.
#RPC_DEPTH_URL=
#RPC_DEPTH_WS_URL=
#RPC_DEPTH_BACKUP_URLS=

# Ordered failover RPCs behind the primary (comma-separated). Default: the
# public endpoint, so an outage on the primary degrades instead of freezing
# the indexer. Set to empty to disable failover.
#RPC_HTTP_BACKUP_URLS=

# Offline development against the deterministic simulator (no network).
#DATA_SOURCE=sim

# Adapter development: run ONLY your venue, skip the heavy history jobs.
#VENUES=myvenue
#BACKFILL=off
#MARKOUT_BACKFILL=off
#GAS_METRIC=off
#DB_PATH=./data/scratch.db
